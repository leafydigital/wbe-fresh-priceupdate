# Copy this file to .env.local and fill in your Supabase project values.
# Find these under Project Settings -> API in the Supabase dashboard.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key — server-only, NEVER expose to the browser or
# commit this to git. Used only by lib/supabase/admin.ts for the
# public price API and supplier-account creation/reset.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used by app/prices/page.tsx to call the public API route
# server-side. Set to your real domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Only used by scripts/seed.ts (optional — has defaults)
SEED_ADMIN_EMAIL=admin@wbefresh.com
SEED_ADMIN_PASSWORD=ChangeMe123!
